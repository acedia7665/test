# Скопируй этот файл в .env и вставь свой ключ.
# Получить бесплатный ключ Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Необязательные настройки (можно не трогать — используются значения по умолчанию)
# Папка с PDF-статьями
PDF_DIR=pdfs
# Итоговый Excel-файл
OUTPUT_XLSX=digest.xlsx
# Модель Gemini
GEMINI_MODEL=gemini-2.5-flash
